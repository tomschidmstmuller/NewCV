---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/style.css';
---

<BaseLayout title="CYBER//DECK :: Nguyễn Ngọc Gia Khang">
  <div class="scanlines"></div>

  <!-- ═══ Navigation ═══ -->
  <header class="dash-header">
    <div class="dash-logo" onclick="openNav()">
      <div class="triangle" id="head-triangle"></div>
    </div>
    <nav class="dash-nav">
      <a href="/" class="active">Dashboard</a>
      <a href="#about">About</a>
      <a href="#skills">Stack</a>
      <a href="#projects">Projects</a>
      <a href="#education">Education</a>
      <a href="/clock">Clock</a>
    </nav>
    <div class="dash-controls">
      <div class="dash-search">
        <i class="fas fa-search"></i>
      </div>
      <div class="dash-avatar">NK</div>
    </div>
  </header>

  <!-- ═══ Side Nav ═══ -->
  <section class="start">
    <nav id="mySidenav" class="sidenav">
      <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">
        <img src="/media-assets/close.png" alt="close menu" />
      </a>
      <div class="align-row">
        <div class="nav-wrapper">
          <a href="/">Work</a>
          <a href="#">MyCV</a>
          <a href="#">Personal</a>
          <a href="#">About</a>
          <a href="/clock">Time?</a>
        </div>
        <div class="decoration-wrapper">
          <div class="eye"><img src="/media-assets/deco.png" /></div>
        </div>
      </div>
    </nav>

    <!-- ═══ Hero ═══ -->
    <div class="main-container">
      <div class="herotxt">
        <div class="terminal-line"><span class="prompt">❯</span> <span class="cmd">init --profile developer</span></div>
        <div class="terminal-line"><span class="prompt">❯</span> <span class="cmd">loading systems... <span style="color:var(--purple)">■</span><span style="color:var(--magenta)">■</span><span style="color:var(--cyan)">■</span> 100%</span></div>
        <div class="terminal-line"><span class="prompt">❯</span> <span class="cmd">access granted. welcome, user.</span></div>

        <h1 class="hero-title">
          <span class="chroma" data-text="Nguyễn Ngọc Gia Khang">Nguyễn Ngọc Gia Khang</span>
        </h1>

        <p class="hero-subtitle">
          <span class="highlight" id="typewriter">Developer</span><span class="typing-cursor"></span>
          <br />
          <span style="font-size:0.75rem;color:var(--text-muted);font-family:var(--font-mono);">Tom Schmidt Müller · Ruan Yu Jia Kang</span>
        </p>

        <div class="terminal-hero">
          <div class="term-line"><span class="prompt" style="color:var(--purple)">❯ whoami</span> <span class="cmd">Software Engineering student from Vietnam</span></div>
          <div class="term-line"><span class="prompt" style="color:var(--purple)">❯ current_focus</span> <span class="cmd">C++ · C# · Python · JS/TS · Linux · Developer Tooling</span></div>
          <div class="term-line"><span class="prompt" style="color:var(--purple)">❯ university</span> <span class="cmd">HUFLIT · Ho Chi Minh City</span></div>
          <div class="term-line"><span class="prompt" style="color:var(--purple)">❯ interests</span> <span class="cmd">Software Engineering · Open Source · Systems · Cybersecurity · Web Dev</span></div>
          <div class="term-line"><span class="prompt" style="color:var(--purple)">❯ philosophy</span> <span class="cmd">Build first. Optimize later.</span></div>
        </div>

        <div class="hero-cta">
          <button class="btn-neon" onclick="document.getElementById('projects').scrollIntoView({behavior:'smooth'})">
            <i class="fas fa-cube"></i>
            <span>View Projects</span>
          </button>
          <button class="btn-neon-outline" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
            <i class="fas fa-terminal"></i>
            <span>Contact</span>
          </button>
        </div>

        <div class="hero-panels">
          <div class="hero-panel">
            <span class="label">Status</span>
            <span class="value green">● Studying</span>
          </div>
          <div class="hero-panel">
            <span class="label">University</span>
            <span class="value">HUFLIT</span>
          </div>
          <div class="hero-panel">
            <span class="label">Target</span>
            <span class="value pink">Siheung Univ.</span>
          </div>
          <div class="hero-panel">
            <span class="label">Stack</span>
            <span class="value">C++, C#, Python, TS</span>
          </div>
        </div>
      </div>

      <div class="outer-heropic-container holo-flicker">
        <div class="inner-heropic-container">
          <div class="reactor">
            <div class="triangle"></div>
            <div class="circle-1"><span></span><span></span><span></span><span></span></div>
            <div class="circle-2"></div>
            <div class="circle-3"><span></span><span></span><span></span></div>
            <div class="circle-4"><span></span><span></span><span></span></div>
            <div class="circle-5"></div>
            <div class="circle-6"></div>
            <div class="circle-7"><span></span><span></span></div>
          </div>
        </div>
        <img src="/media-assets/robothand.png" />
      </div>
    </div>
  </section>

  <!-- ═══ About ═══ -->
  <section class="cv-about" id="about">
    <div class="cv-about-grid">
      <!-- Left: vertical label + avatar placeholder -->
      <div class="cv-about-side">
        <span class="cv-about-vertical">ABOUT ME</span>
        <figure class="cv-avatar">
          <div class="cv-avatar-frame">
            <img src="../../source/media-assets/avatar.jpg" alt="Larvene's profile picture">
          </div>
          <figcaption>avatar.jpg</figcaption>
        </figure>
      </div>

      <!-- Right: content -->
      <div class="cv-about-main">
        <div class="cv-about-meta">
          <span>Software Engineering</span>
          <span>Student</span>
          <span>2026</span>
        </div>

        <p class="cv-about-text">
          First-year Software Engineering student at <strong>HUFLIT</strong> with a practical foundation in
          programming and software development. Comfortable working with C++, C#, Python, JavaScript, and
          TypeScript, with experience building small personal projects and exploring different development
          environments and technologies.
        </p>
        <p class="cv-about-text">
          I learn primarily through hands-on projects and independent experimentation, and I am particularly
          interested in software engineering, open-source development, systems, and developer tooling. Currently
          looking to strengthen my professional experience through internships, collaborative projects, and
          real-world software development.
        </p>

        <div class="cv-about-blocks">
          <div class="cv-about-block">
            <h3>Education</h3>
            <ul>
              <li>HUFLIT · Software Engineering · 2026 – Present</li>
              <li>GDTX Continuing Education · Completed</li>
            </ul>
          </div>
          <div class="cv-about-block">
            <h3>Skills</h3>
            <ul>
              <li>C++ · C# · Python · JavaScript · TypeScript</li>
              <li>Git · Node.js · Vite · Astro · Tailwind</li>
              <li>Linux · Windows · Neovim · CLI · .NET</li>
            </ul>
          </div>
          <div class="cv-about-block">
            <h3>Certifications</h3>
            <ul>
              <li>IELTS Academic · 6.5</li>
              <li>ĐGNL · 710 points</li>
              <li>Cambridge English B1 · 155</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cv-about {
      padding: 90px 0;
      position: relative;
      z-index: 1;
    }
    .cv-about-grid {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: minmax(220px, 300px) 1fr;
      gap: 4rem;
      align-items: center;
    }
    .cv-about-side {
      display: flex;
      gap: 1.25rem;
      align-items: center;
    }
    .cv-about-vertical {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.45em;
      color: var(--text-muted);
      text-transform: uppercase;
      white-space: nowrap;
      padding-top: 0.25rem;
    }
    .cv-avatar {
      margin: 0;
      width: 100%;
    }
    .cv-avatar-frame {
      position: relative;
      aspect-ratio: 3 / 4;
      border: 1px dashed var(--glass-border);
      background: rgba(10, 3, 20, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cv-avatar-frame::before,
    .cv-avatar-frame::after {
      content: '';
      position: absolute;
      width: 14px;
      height: 14px;
      border: 1px solid var(--purple);
      z-index: 1;
      pointer-events: none;
    }
    .cv-avatar-frame::before {
      top: -1px;
      left: -1px;
      border-right: none;
      border-bottom: none;
    }
    .cv-avatar-frame::after {
      bottom: -1px;
      right: -1px;
      border-left: none;
      border-top: none;
    }
    .cv-avatar-placeholder {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }
    .cv-avatar figcaption {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--text-muted);
      margin-top: 0.6rem;
      letter-spacing: 0.05em;
    }
    .cv-about-main {
      border-top: 1px solid var(--glass-border);
      padding-top: 0.75rem;
    }
    .cv-about-meta {
      display: flex;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 1.75rem;
    }
    .cv-about-meta span:not(:first-child) {
      padding-left: 0.75rem;
      border-left: 1px solid var(--glass-border);
    }
    .cv-about-text {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.8;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      max-width: 60ch;
    }
    .cv-about-text strong {
      color: var(--purple);
      font-weight: 600;
    }
    .cv-about-blocks {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      border-top: 1px solid var(--glass-border);
      padding-top: 1.5rem;
      margin-top: 1rem;
    }
    .cv-about-block h3 {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      color: var(--purple);
      text-transform: uppercase;
      margin: 0 0 0.9rem;
    }
    .cv-about-block ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .cv-about-block li {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--text-secondary);
      line-height: 1.9;
      padding-left: 1rem;
      position: relative;
    }
    .cv-about-block li::before {
      content: '>';
      position: absolute;
      left: 0;
      color: var(--text-muted);
    }
    @media (max-width: 768px) {
      .cv-about-grid {
        grid-template-columns: minmax(140px, 200px) 1fr;
        gap: 2rem;
      }
      .cv-about-side {
        gap: 0.75rem;
      }
      .cv-about-vertical {
        font-size: 0.6rem;
        letter-spacing: 0.3em;
      }
      .cv-avatar-placeholder {
        font-size: 0.65rem;
      }
      .cv-about-blocks {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- ═══ Skills ═══ -->
  <section class="skills" id="skills">
    <div class="section-label">Expertise</div>
    <h2 class="section-title">Tech Stack</h2>

    <div class="skill-bars">
      <div class="bar">
        <div class="info">
          <span>C++</span>
          <span>Comfortable</span>
        </div>
        <div class="progress-line html"><span></span></div>
      </div>
      <div class="bar">
        <div class="info">
          <span>C#</span>
          <span>Comfortable</span>
        </div>
        <div class="progress-line css"><span></span></div>
      </div>
      <div class="bar">
        <div class="info">
          <span>Python</span>
          <span>Comfortable</span>
        </div>
        <div class="progress-line python"><span></span></div>
      </div>
      <div class="bar">
        <div class="info">
          <span>JavaScript</span>
          <span>Comfortable</span>
        </div>
        <div class="progress-line jquery"><span></span></div>
      </div>
      <div class="bar">
        <div class="info">
          <span>TypeScript</span>
          <span>Basic / Intermediate</span>
        </div>
        <div class="progress-line mysql"><span></span></div>
      </div>
    </div>

    <div style="max-width:700px;margin:2rem auto 0;display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:center;">
      <span class="badge"><i class="fab fa-cuttlefish"></i> C++</span>
      <span class="badge"><i class="fas fa-code"></i> C#</span>
      <span class="badge"><i class="fab fa-python"></i> Python</span>
      <span class="badge"><i class="fab fa-js"></i> JavaScript</span>
      <span class="badge"><i class="fab fa-js"></i> TypeScript</span>
      <span class="badge"><i class="fab fa-git-alt"></i> Git &amp; GitHub</span>
      <span class="badge"><i class="fab fa-node-js"></i> Node.js / npm</span>
      <span class="badge"><i class="fas fa-file-code"></i> JSON</span>
      <span class="badge"><i class="fab fa-js"></i> Vite</span>
      <span class="badge"><i class="fas fa-rocket"></i> Astro</span>
      <span class="badge"><i class="fas fa-palette"></i> Tailwind CSS</span>
      <span class="badge"><i class="fab fa-microsoft"></i> .NET / Visual Studio</span>
      <span class="badge"><i class="fab fa-linux"></i> Linux</span>
      <span class="badge"><i class="fab fa-windows"></i> Windows</span>
      <span class="badge"><i class="fas fa-terminal"></i> Neovim</span>
      <span class="badge"><i class="fas fa-microchip"></i> Computer Architecture</span>
    </div>
  </section>

  <!-- ═══ Environment ═══ -->
  <section class="contact-section" style="padding-top:0;">
    <div class="section-label">Environment</div>
    <h2 class="section-title">Dev Setup</h2>

    <div class="contact-container" style="max-width:600px;">
      <div style="font-family:var(--font-mono);font-size:0.8rem;display:flex;flex-direction:column;gap:0.6rem;">
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">OS</span>
          <span style="color:var(--cyan);">Linux · Windows</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">Editor</span>
          <span style="color:var(--cyan);">Neovim</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">CLI</span>
          <span style="color:var(--cyan);">Command-line environments</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">Frontend</span>
          <span style="color:var(--cyan);">Vite · Astro · Tailwind</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">Data</span>
          <span style="color:var(--cyan);">JSON &amp; basic data handling</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--glass-border);">
          <span style="color:var(--text-muted);">VCS</span>
          <span style="color:var(--cyan);">Git &amp; GitHub</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;">
          <span style="color:var(--text-muted);">Learning</span>
          <span style="color:var(--cyan);">Computer architecture · Systems</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Strengths ═══ -->
  <section class="contact-section" style="padding-top:0;">
    <div class="section-label">Capabilities</div>
    <h2 class="section-title">Strengths</h2>

    <div class="work" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr));max-width:1100px;margin:20px auto;">
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-graduation-cap work-icon"></i></div>
          <h3>Self-directed learning</h3>
          <p>Able to learn unfamiliar technologies independently through documentation, experimentation, and project-based practice rather than relying entirely on formal coursework.</p>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-layer-group work-icon"></i></div>
          <h3>Broad programming foundation</h3>
          <p>Have worked with several programming languages and paradigms, allowing me to adapt relatively quickly when moving between different technical environments.</p>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-bug work-icon"></i></div>
          <h3>Problem solving</h3>
          <p>Enjoy debugging and investigating technical problems, especially when the solution requires understanding what is happening underneath the abstraction rather than simply applying a predefined fix.</p>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-brain work-icon"></i></div>
          <h3>Technical curiosity</h3>
          <p>Strong interest in understanding how software and computer systems work, including development tools, operating systems, performance, and lower-level concepts.</p>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-hammer work-icon"></i></div>
          <h3>Hands-on mindset</h3>
          <p>Prefer learning by building. Personal projects and experimentation have been an important part of developing my programming skills.</p>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-content">
          <div class="work-item-top" style="padding:0 0 10px;"><i class="fas fa-exchange-alt work-icon"></i></div>
          <h3>Adaptability</h3>
          <p>Comfortable moving between different tools, languages, operating systems, and development environments while learning what is necessary for the task.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Projects ═══ -->
  <section class="work-container" id="projects">
    <div class="section-label">Portfolio</div>
    <h2 class="section-title">Projects</h2>

    <div class="work">
      <div class="work-item">
        <div class="work-item-top">
          <i class="fas fa-coffee work-icon"></i>
          <span class="work-year">2025</span>
        </div>
        <div class="work-item-content">
          <h3>VietCoffee</h3>
          <p style="margin-bottom:6px;color:var(--text-muted);font-family:var(--font-mono);font-size:0.7rem;">Café Operations Platform</p>
          <p>A local-first café management system designed to support real-world business workflows and online interaction.</p>
          <div style="margin:0.75rem 0;">
            <span class="minibadge">product management</span>
            <span class="minibadge">order handling</span>
            <span class="minibadge">sales workflow</span>
            <span class="minibadge">offline/local</span>
          </div>
          <p style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-muted);margin-bottom:0.75rem;">JavaScript · HTML/CSS · System Design</p>
          <a href="https://github.com/larvenejafemcoder" target="_blank" class="work-link"><i class="fab fa-github"></i> GitHub</a>
        </div>
      </div>
      <div class="work-item">
        <div class="work-item-top">
          <i class="fas fa-graduation-cap work-icon"></i>
          <span class="work-year">2025</span>
        </div>
        <div class="work-item-content">
          <h3>ScholarNet VN</h3>
          <p style="margin-bottom:6px;color:var(--text-muted);font-family:var(--font-mono);font-size:0.7rem;">Vocabulary & University Information Platform</p>
          <p>Educational web platform focused on vocabulary learning, university admissions, and scholarship discovery.</p>
          <div style="margin:0.75rem 0;">
            <span class="minibadge">learning workflows</span>
            <span class="minibadge">university info</span>
            <span class="minibadge">progress tracking</span>
            <span class="minibadge">scholarship discovery</span>
          </div>
          <p style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-muted);margin-bottom:0.75rem;">JavaScript · Web Development · Frontend Systems</p>
          <a href="https://github.com/larvenejafemcoder" target="_blank" class="work-link"><i class="fab fa-github"></i> GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Objectives ═══ -->
  <section class="contact-section" style="padding-top:0;">
    <div class="section-label">Roadmap</div>
    <h2 class="section-title">Current Goal</h2>

    <div class="contact-container" style="max-width:700px;">
      <p style="font-family:var(--font-body);font-size:0.95rem;color:var(--text-secondary);line-height:1.7;margin-bottom:1.5rem;">
        Seeking opportunities to gain <span style="color:var(--purple);font-weight:600;">real-world software development experience</span>,
        contribute to collaborative projects, and gradually develop from a student programmer
        into a well-rounded software engineer.
      </p>
      <ul style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-secondary);list-style:none;display:flex;flex-direction:column;gap:0.7rem;">
        <li><span style="color:var(--purple)">⟡</span> Current university: <strong style="color:var(--cyan);">HUFLIT · Software Engineering</strong></li>
        <li><span style="color:var(--purple)">⟡</span> Dream / target university: <strong style="color:var(--cyan);">Siheung University, South Korea</strong></li>
        <li><span style="color:var(--purple)">⟡</span> Searching for internships &amp; collaborative projects</li>
        <li><span style="color:var(--purple)">⟡</span> Contributing to open source / FOSS</li>
        <li><span style="color:var(--purple)">⟡</span> Deepening systems programming and developer tooling</li>
      </ul>
    </div>
  </section>

  <!-- ═══ Areas of Interest ═══ -->
  <section class="contact-section" style="padding-top:0;">
    <div class="section-label">Signal Map</div>
    <h2 class="section-title">Areas of Interest</h2>

    <div class="contact-container" style="max-width:700px;">
