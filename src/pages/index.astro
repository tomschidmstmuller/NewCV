---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/style.css';

const profile = {
  name: 'Nguyễn Ngọc Gia Khang',
  role: 'Software Engineering Student',
  email: 'tomkancaston@gmail.com',
  github: 'https://github.com/larvenejafemcoder',
  githubHandle: 'github.com/larvenejafemcoder',
  location: 'Ho Chi Minh City, Vietnam',
  tagline: 'Software engineering student building software, tools, and experiments.',
};

const nav = [
  { id: 'about', label: '~/about' },
  { id: 'projects', label: '~/projects' },
  { id: 'stack', label: '~/stack' },
  { id: 'contact', label: '~/contact' },
];

const stackPrimary = [
  { name: 'C++', level: 'Comfortable', width: 80 },
  { name: 'C#', level: 'Comfortable', width: 80 },
  { name: 'Python', level: 'Comfortable', width: 78 },
  { name: 'JavaScript', level: 'Comfortable', width: 80 },
  { name: 'TypeScript', level: 'Building / Intermediate', width: 60 },
];

const stackBadges = [
  'C++', 'C#', 'Python', 'JavaScript', 'TypeScript',
  'Git & GitHub', 'Node.js / npm', 'JSON', 'Vite', 'Astro', 'Tailwind CSS',
  '.NET / Visual Studio', 'Linux', 'Windows', 'Neovim', 'Computer Architecture',
];

const projects = [
  {
    name: 'VietCoffee',
    year: '2025',
    tag: 'Café Operations Platform',
    description: 'A local-first café management system designed to support real-world business workflows and online interaction.',
    tags: ['product management', 'order handling', 'sales workflow', 'offline/local'],
    tech: 'JavaScript · HTML/CSS · System Design',
    status: 'Personal project',
    preview: '/media-assets/vietcoffee.png',
    github: 'https://github.com/larvenejafemcoder',
  },
  {
    name: 'ScholarNet VN',
    year: '2025',
    tag: 'Vocabulary & University Information Platform',
    description: 'Educational web platform focused on vocabulary learning, university admissions, and scholarship discovery.',
    tags: ['learning workflows', 'university info', 'progress tracking', 'scholarship discovery'],
    tech: 'JavaScript · Web Development · Frontend Systems',
    status: 'Personal project',
    preview: '/media-assets/scholarnet.png',
    github: 'https://github.com/larvenejafemcoder',
  },
];

const strengths = [
  { icon: 'fa-graduation-cap', title: 'Self-directed learning', text: 'Able to learn unfamiliar technologies independently through documentation, experimentation, and project-based practice rather than relying entirely on formal coursework.' },
  { icon: 'fa-layer-group', title: 'Broad programming foundation', text: 'Have worked with several programming languages and paradigms, allowing me to adapt relatively quickly when moving between different technical environments.' },
  { icon: 'fa-bug', title: 'Problem solving', text: 'Enjoy debugging and investigating technical problems, especially when the solution requires understanding what is happening underneath the abstraction.' },
  { icon: 'fa-brain', title: 'Technical curiosity', text: 'Strong interest in understanding how software and computer systems work, including development tools, operating systems, performance, and lower-level concepts.' },
  { icon: 'fa-hammer', title: 'Hands-on mindset', text: 'Prefer learning by building. Personal projects and experimentation have been an important part of developing my programming skills.' },
  { icon: 'fa-exchange-alt', title: 'Adaptability', text: 'Comfortable moving between different tools, languages, operating systems, and development environments while learning what is necessary for the task.' },
];

const certifications = [
  { icon: 'fa-language', name: 'IELTS', value: 'Academic: 6.5', note: 'Working proficiency in English for academic and technical environments.' },
  { icon: 'fa-university', name: 'ĐGNL', value: '710 points', note: 'Vietnam National University competency assessment.' },
  { icon: 'fa-book', name: 'Cambridge', value: 'English B1 · 155', note: 'Cambridge English qualification at B1 level.' },
  { icon: 'fa-trophy', name: 'Academics', value: 'High-School Performance', note: 'Strengths in Informatics, Mathematics, and Technology.' },
];
---

<BaseLayout title="Nguyễn Ngọc Gia Khang — Software Engineering Student">
  <div class="shell">
    <!-- ═══════════ Profile sidebar ═══════════ -->
    <aside class="side-panel" id="side-panel" aria-label="Profile and navigation">
      <button class="side-menu-btn" id="side-menu-btn" aria-expanded="false" aria-controls="side-nav" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>

      <div class="side-inner">
        <div class="side-brand">
          <span class="side-brand-mark">
            <img src="/media-assets/andzilogoW.png" alt="" width="40" height="40" />
          </span>
          <span>PROFILE</span>
        </div>

        <div class="side-profile">
          <figure class="side-avatar">
            <img src="/media-assets/avatar.jpg" alt="Nguyễn Ngọc Gia Khang" width="112" height="112" />
          </figure>
          <h1 class="side-name">{profile.name}</h1>
          <p class="side-role">{profile.role}</p>
          <p class="side-loc"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {profile.location}</p>
          <p class="side-tagline">{profile.tagline}</p>
        </div>

        <nav class="side-nav" id="side-nav" aria-label="Section navigation">
          <span class="side-nav-title">NAVIGATION</span>
          <div class="side-nav-links">
            {nav.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
          </div>
        </nav>

        <div class="side-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-text">Available</span>
        </div>
      </div>
    </aside>

    <!-- ═══════════ Main content ═══════════ -->
    <main class="main-content" id="main-content" tabindex="-1">
      <!-- Hero -->
      <section class="section hero reveal" aria-labelledby="hero-title">
        <p class="hero-kicker">Software Engineering Student — Ho Chi Minh City</p>
        <h1 class="hero-name" id="hero-title">{profile.name}</h1>
        <p class="hero-role">{profile.role}</p>
        <p class="hero-desc">
          I build software, developer tools, and experiments while exploring how computers actually work.
        </p>

        <div class="btn-row">
          <a class="btn btn-primary" href="#projects">View Projects <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          <a class="btn btn-secondary" href={profile.github} target="_blank" rel="noopener">
            GitHub <i class="fab fa-github" aria-hidden="true"></i>
          </a>
        </div>

        <div class="terminal-window" role="presentation">
          <div class="terminal-bar">
            <span class="term-dot" style="background:#ff5f56"></span>
            <span class="term-dot" style="background:#ffbd2e"></span>
            <span class="term-dot" style="background:#27c93f"></span>
            <span class="term-path">~/profile — zsh</span>
          </div>
          <div class="terminal-body">
            <div class="term-line"><span class="prompt">$</span> <span class="cmd">whoami</span></div>
            <div class="term-line"><span class="out">{profile.name}</span></div>
            <div class="term-line"><span class="out-sec">{profile.role}</span></div>
            <div class="term-line"><span class="out-sec">{profile.location}</span></div>
            <div class="term-gap"></div>
            <div class="term-line"><span class="prompt">$</span> <span class="cmd">./focus</span></div>
            <div class="term-line"><span class="out">C++ · C# · Python · JavaScript/TypeScript</span></div>
            <div class="term-line"><span class="out-sec">Linux · Developer Tooling</span></div>
            <div class="term-gap"></div>
            <div class="term-line"><span class="prompt">$</span> <span class="cursor-blink" aria-hidden="true"></span></div>
          </div>
        </div>
      </section>

      <!-- Featured work -->
      <section class="section reveal" id="projects" aria-labelledby="projects-title">
        <div class="section-label">~/projects</div>
        <h2 class="section-title" id="projects-title">Featured Work</h2>

        <div class="project-grid">
          {projects.map((p) => (
            <article class="project-card">
              <div class="project-shot">
                <div class="project-shot-fallback">
                  <span class="fb-label">{p.tag}</span>
                  <span class="fb-name">{p.name}</span>
                  <span class="fb-hint">Preview image pending</span>
                </div>
                <img src={p.preview} alt={`${p.name} preview`} loading="lazy" onerror="this.style.display='none'" />
              </div>
              <div class="project-card-body">
                <div class="project-head">
                  <h3>{p.name}</h3>
                  <span class="project-year">{p.year}</span>
                </div>
                <p class="project-tag">{p.tag}</p>
                <p class="project-desc">{p.description}</p>
                <div class="project-meta">
                  <span class="project-status"><span class="status-dot" aria-hidden="true"></span>{p.status}</span>
                  <span class="project-tech">{p.tech}</span>
                </div>
                <div class="project-links">
                  <a href={p.github} target="_blank" rel="noopener">
                    <i class="fab fa-github" aria-hidden="true"></i> GitHub
                  </a>
                  <a href={p.github} target="_blank" rel="noopener">
                    View Project <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="github-stats">
          <img
            src={`https://github-readme-stats.vercel.app/api?username=larvenejafemcoder&show_icons=true&theme=transparent&bg_color=F7F8F6&border_color=DCE3E0&text_color=66716E&title_color=009E87&icon_color=009E87`}
            alt="GitHub statistics for larvenejafemcoder"
            loading="lazy"
          />
          <img
            src={`https://github-readme-streak-stats.herokuapp.com/?user=larvenejafemcoder&theme=transparent&background=F7F8F6&border=DCE3E0&stroke=DCE3E0&ring=009E87&fire=009E87&currStreakNum=17201E&sideNums=009E87&currStreakLabel=009E87&sideLabels=66716E&dates=66716E`}
            alt="GitHub contribution streak for larvenejafemcoder"
            loading="lazy"
          />
        </div>
      </section>

      <!-- About -->
      <section class="section reveal" id="about" aria-labelledby="about-title">
        <div class="section-label">~/about</div>
        <h2 class="section-title" id="about-title">About</h2>

        <div class="content-block">
          <p class="lead">
            First-year <strong>Software Engineering</strong> student at <strong>HUFLIT</strong> with a practical foundation
            in programming and software development. Comfortable working with C++, C#, Python, JavaScript, and TypeScript,
            and experienced building small personal projects across different environments and technologies.
          </p>
        </div>

        <h3 class="subhead">Strengths</h3>
        <div class="grid-cards">
          {strengths.map((s) => (
            <div class="card">
              <div class="card-icon"><i class={`fas ${s.icon}`} aria-hidden="true"></i></div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>

        <div class="quick-facts">
          <div class="fact">
            <span class="fact-label">Status</span>
            <ul>
              <li><span class="status-dot" aria-hidden="true"></span> Studying · HUFLIT</li>
              <li><span class="status-dot" aria-hidden="true"></span> Target · Siheung Univ.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Stack -->
      <section class="section reveal" id="stack" aria-labelledby="stack-title">
        <div class="section-label">~/stack</div>
        <h2 class="section-title" id="stack-title">Stack</h2>

        <div class="skill-bars">
          {stackPrimary.map((s) => (
            <div class="bar">
              <div class="info">
                <span>{s.name}</span>
                <span class="info-level">{s.level}</span>
              </div>
              <div class="progress-line"><span style={`width:${s.width}%`}></span></div>
            </div>
          ))}
        </div>

        <h3 class="subhead">Tools &amp; Technologies</h3>
        <div class="badge-cloud">
          {stackBadges.map((b) => <span class="badge">{b}</span>)}
        </div>

        <div class="quick-facts">
          <div class="fact">
            <span class="fact-label">Dev Setup</span>
            <ul>
              <li>OS · Linux / Windows</li>
              <li>Editor · Neovim</li>
              <li>Frontend · Vite · Astro · Tailwind</li>
              <li>VCS · Git &amp; GitHub</li>
            </ul>
          </div>
          <div class="fact">
            <span class="fact-label">Learning</span>
            <ul>
              <li>Computer architecture &amp; systems</li>
              <li>Open source / FOSS contributions</li>
              <li>Software development practices</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Education -->
      <section class="section reveal" id="education" aria-labelledby="education-title">
        <div class="section-label">~/education</div>
        <h2 class="section-title" id="education-title">Education</h2>

        <div class="timeline">
          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-body">
              <p class="timeline-meta">2026 — Present</p>
              <h3>HUFLIT · Software Engineering</h3>
              <p>Ho Chi Minh City University of Foreign Languages and Information Technology. First-year Software Engineering student working toward a well-rounded engineering foundation.</p>
            </div>
          </article>
          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-body">
              <p class="timeline-meta">Completed</p>
              <h3>GDTX Continuing Education</h3>
              <p>Completed upper-secondary education through the GDTX (Continuing Education) program.</p>
            </div>
          </article>
        </div>

        <h3 class="subhead">Certifications &amp; Results</h3>
        <div class="grid-cards cert-grid">
          {certifications.map((c) => (
            <div class="card">
              <div class="card-icon"><i class={`fas ${c.icon}`} aria-hidden="true"></i></div>
              <p class="card-label">{c.name}</p>
              <h3>{c.value}</h3>
              <p>{c.note}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact -->
      <section class="section reveal" id="contact" aria-labelledby="contact-title">
        <div class="section-label">~/contact</div>
        <h2 class="section-title" id="contact-title">Contact</h2>
        <p class="lead">Have a project, an internship, or just want to say hi? My inbox is open.</p>

        <div class="contact-links">
          <a class="contact-link" href={`mailto:${profile.email}`}>
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <span class="contact-key">email</span>
            <span class="contact-val">{profile.email}</span>
          </a>
          <a class="contact-link" href={profile.github} target="_blank" rel="noopener">
            <i class="fab fa-github" aria-hidden="true"></i>
            <span class="contact-key">github</span>
            <span class="contact-val">{profile.githubHandle}</span>
          </a>
          <div class="contact-link is-placeholder">
            <i class="fab fa-linkedin" aria-hidden="true"></i>
            <span class="contact-key">linkedin</span>
            <span class="contact-val">YOUR_LINKEDIN_URL</span>
            <span class="contact-note">add your profile URL</span>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="main-footer">
        <p class="footer-quote">Low-level curiosity with high-level execution.</p>
        <p class="footer-line">Still learning. Still building.</p>
        <p class="footer-copy">© 2026 {profile.name}</p>
      </footer>
    </main>
  </div>

  <script src="/myscript.js" is:inline></script>
</BaseLayout>
