---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/style.css';
---

<BaseLayout title="Chrono Terminal :: Nguyễn Ngọc Gia Khang">
  <div class="scanlines"></div>

  <header class="clock-nav">
    <a href="/" class="clock-back"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to portfolio</a>
    <span class="clock-title">chrono://system-time</span>
  </header>

  <main class="clock-main">
    <div class="clock">
      <div class="clock-terminal">❯ system_time --live</div>
      <p class="clock-day" id="day">--day--</p>
      <p class="clock-time" id="time">00:00:00</p>
      <p class="clock-midday" id="midday">XX</p>
    </div>
  </main>

  <script src="/myscript.js" is:inline></script>
  <script>
    var time = document.getElementById("time");
    var day = document.getElementById("day");
    var midday = document.getElementById("midday");

    var clock = setInterval(function calcTime() {
      var date_now = new Date();
      var hr = date_now.getHours();
      var min = date_now.getMinutes();
      var sec = date_now.getSeconds();
      var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

      day.textContent = days[date_now.getDay()];
      midday.textContent = hr >= 12 ? "PM" : "AM";

      if (hr == 0) {
        hr = 12;
      } else if (hr > 12) {
        hr -= 12;
      }

      hr = hr < 10 ? "0" + hr : hr;
      min = min < 10 ? "0" + min : min;
      sec = sec < 10 ? "0" + sec : sec;

      time.textContent = hr + ":" + min + ":" + sec;
    }, 1000);
  </script>
</BaseLayout>

<style>
  .clock-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    background: rgba(7, 3, 12, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--glass-border);
  }
  .clock-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    transition: all 0.3s;
  }
  .clock-back:hover {
    color: var(--purple);
    border-color: var(--purple);
    box-shadow: 0 0 14px var(--purple-glow);
  }
  .clock-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
  }
  .clock-main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 3rem;
    position: relative;
    z-index: 1;
  }
  .clock {
    width: min(92vw, 480px);
    padding: 3.5rem 2.5rem;
    border-radius: 1.5rem;
    background: rgba(15, 7, 25, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 0 24px rgba(157, 78, 221, 0.06);
    text-align: center;
  }
  .clock-terminal {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .clock-day {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .clock-time {
    font-family: var(--font-display);
    font-size: clamp(3rem, 14vw, 5rem);
    font-weight: 700;
    color: var(--purple);
    text-shadow: 0 0 20px var(--purple-glow), 0 0 40px rgba(157, 78, 221, 0.15);
    line-height: 1;
  }
  .clock-midday {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 5vw, 1.6rem);
    color: var(--cyan);
    margin-top: 0.5rem;
    text-shadow: 0 0 12px var(--cyan-glow);
  }
</style>
