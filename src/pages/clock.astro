---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/style.css';
---

<BaseLayout title="CYBER//DECK :: Nguyễn Ngọc Gia Khang — Chrono Terminal">
  <div class="scanlines"></div>

  <header class="dash-header">
    <div class="dash-logo" onclick="openNav()">
      <div class="triangle" id="head-triangle"></div>
    </div>
    <nav class="dash-nav">
      <a href="/">Dashboard</a>
      <a href="/#services">Services</a>
      <a href="/#skills">Skills</a>
      <a href="/#projects">Projects</a>
      <a href="/clock" class="active">Clock</a>
    </nav>
    <div class="dash-controls">
      <div class="dash-search">
        <i class="fas fa-search"></i>
      </div>
      <div class="dash-avatar">TM</div>
    </div>
  </header>

  <section class="start">
    <nav id="mySidenav" class="sidenav">
      <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">
        <img src="/media-assets/close.png" alt="close menu" />
      </a>
      <div class="align-row">
        <div class="nav-wrapper">
          <a href="/">Work</a>
          <a href="#">MyCV</a>
          <a href="#">Personal</a>
          <a href="#">About</a>
          <a href="/clock">Time?</a>
        </div>
        <div class="decoration-wrapper">
          <img src="/media-assets/deco.png" />
        </div>
      </div>
    </nav>

    <div class="logo" onclick="openNav()">
      <div class="trap" id="trap1"></div>
      <div class="trap" id="trap2"></div>
      <div class="trap" id="trap3"></div>
    </div>

    <div class="container">
      <div class="clock">
        <div class="terminal-line" style="text-align:center;justify-content:center;"><span class="prompt">❯</span> <span class="cmd">chrono://system-time</span></div>
        <div id="day">--day--</div>
        <div class="clock-wrapper">
          <div id="time">00:00:00</div>
          <div id="midday">XX</div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .start .container {
      z-index: 1;
      position: relative;
    }
    .logo {
      position: fixed;
      top: 60px;
      left: 0;
      z-index: 2;
    }
    #day {
      font-family: var(--font-mono);
      font-size: 20px;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }
    #time {
      font-family: var(--font-display);
      font-size: clamp(3rem, 12vw, 5rem);
      color: var(--purple);
      text-shadow: 0 0 20px var(--purple-glow), 0 0 40px rgba(157, 78, 221, 0.15);
    }
    #midday {
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 4vw, 1.8rem);
      color: var(--cyan);
      text-shadow: 0 0 12px var(--cyan-glow);
    }
  </style>

  <script src="/myscript.js" is:inline></script>
  <script>
    var time = document.getElementById("time");
    var day = document.getElementById("day");
    var midday = document.getElementById("midday");

    var clock = setInterval(function calcTime() {
      var date_now = new Date();
      var hr = date_now.getHours();
      var min = date_now.getMinutes();
      var sec = date_now.getSeconds();
      var middayValue = "AM";
      var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

      day.textContent = days[date_now.getDay()];

      middayValue = hr >= 12 ? "PM" : "AM";

      if (hr == 0) {
        hr = 12;
      } else if (hr > 12) {
        hr -= 12;
      }

      hr = hr < 10 ? "0" + hr : hr;
      min = min < 10 ? "0" + min : min;
      sec = sec < 10 ? "0" + sec : sec;

      time.textContent = hr + ":" + min + ":" + sec;
      midday.textContent = middayValue;
    }, 1000);
  </script>
</BaseLayout>
